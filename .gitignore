# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── 虚拟环境 ──────────────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── 测试与缓存产物 ────────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ── 本仓库自己会生成的东西 ────────────────────────────────────────────────────
# 工具实跑会写产物；`.pyc` 的**内容随运行时间变化** ⇒ 留着就不可复现
out/
outputs/
*.log
*.jsonl
!MANIFEST.json

# ── 实验数据：绝对不进仓库 ────────────────────────────────────────────────────
# 本工具链处理的是实验产出（raw_trials.csv 等）。它们体积大、
# 且往往含第三方语料与被测系统的响应 —— **一律由使用者自己提供**。
data/
prompts/
paper/
papers/
*.csv
*.csv.gz
*.parquet
*.xlsx

# ── 凭据 ──────────────────────────────────────────────────────────────────────
.env
.env.*
*.key
*.pem
secrets/

# ── 编辑器与系统 ──────────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
